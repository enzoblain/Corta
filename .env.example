# Copy to .env and fill in. Never commit .env.
APP_PASSWORD=change-me
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Host/port are used by the Python version only; the Next.js container listens on 3000.
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
# Set to 1 when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=0
# Set to 1 behind exactly ONE trusted reverse proxy (it must append the client IP to X-Forwarded-For): the login rate limit then uses X-Forwarded-For per client.
# Leave 0 otherwise: a single global bucket is used (X-Forwarded-For is spoofable).
TRUST_PROXY=0
# Optional: enables AI rewriting/classification (server-side only). Without it, ideas go to the Inbox.
ANTHROPIC_API_KEY=
